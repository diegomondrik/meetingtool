# MeetingTool v3.0 — .gitignore

# Credentials
.env
*.env

# Meeting data — never commit client recordings or reports
projects/
*.mp4
*.MP4
*.docx
*.txt
!requirements.txt
imagenes_reunion/
report_*.md
report_*.docx
handoff_*.json
transcript_half*.txt

# MeetingTool config (machine-specific)
mip.config.json

# Logs
*.log
frames_discarded.log

# Smoke test folders
smoke_test_*/

# Test fixtures (generated on setup)
tools/test_meeting.mp4

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
venv/
env/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Windows launcher (machine-specific, generated by mip.py setup)
MeetingTool.bat

# SDAD development methodology (not part of the distributed app)
.claude/
CLAUDE.md
SPEC.md
DECISIONS.md
LESSON_LIBRARY.md
dev-notes/
memory/
